// Prisma schema — PostgreSQL is the real store behind the app.
//
// Postgres rather than SQLite because this is a teaching library that grows:
// one deck can carry a hundred questions and their answer keys, several
// teachers may add to the same bank, and searching inside an answer key needs
// full-text search rather than a LIKE. Arrays are native, and JSONB keeps a
// slide's blocks as a document that is still queryable.

// The classic generator writes into node_modules/@prisma/client, which Next
// keeps out of its server bundle via `serverExternalPackages`. A generated
// source tree inside `src/` would get compiled by the bundler instead.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Who may use the app. Admin > Teacher > Student is a containment, not a
/// rank: a teacher is not an admin, and a student can never write a deck.
enum Role {
  ADMIN
  TEACHER
  STUDENT
}

model User {
  id           String   @id
  username     String   @unique
  /// bcrypt hash; the plaintext never reaches the database or a log.
  passwordHash String
  role         Role     @default(TEACHER)
  displayName  String   @default("")
  disabled     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  presentations Presentation[]
  questions     Question[]
  sessions      Session[]

  /// This user as the teacher half of the relationship.
  taughtStudent TeacherStudent[] @relation("TeacherSide")
  /// This user as the student half.
  studyingUnder TeacherStudent[] @relation("StudentSide")

  sharesGranted  Share[]       @relation("ShareTeacher")
  sharesReceived Share[]       @relation("ShareStudent")
  liveSessions   LiveSession[]
}

model Session {
  /// SHA-256 of the cookie value, never the value itself: a database dump
  /// should not be enough to impersonate anyone.
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// A student can have many teachers and a teacher many students, so this is
/// genuinely many-to-many rather than a `teacherId` on the student row.
model TeacherStudent {
  teacherId String
  studentId String
  createdAt DateTime @default(now())

  teacher User @relation("TeacherSide", fields: [teacherId], references: [id], onDelete: Cascade)
  student User @relation("StudentSide", fields: [studentId], references: [id], onDelete: Cascade)

  @@id([teacherId, studentId])
  @@index([studentId])
}

/// A deck a teacher has chosen to put in front of one student. Sharing is per
/// student rather than per teacher, so one awkward deck does not become everyone's.
model Share {
  id             String   @id
  presentationId String
  teacherId      String
  studentId      String
  createdAt      DateTime @default(now())

  presentation Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  teacher      User         @relation("ShareTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  student      User         @relation("ShareStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([presentationId, studentId])
  @@index([studentId])
}

/// A live teaching session. The current step lives here so a student who joins
/// late can catch up immediately instead of waiting for the next broadcast.
model LiveSession {
  id             String    @id
  /// Short code students type to join.
  code           String    @unique
  teacherId      String
  title          String    @default("")
  /// The deck being taught.
  presentationId String?
  step           Int       @default(0)
  live           Boolean   @default(false)
  startedAt      DateTime  @default(now())
  endedAt        DateTime?

  teacher      User          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  presentation Presentation? @relation(fields: [presentationId], references: [id], onDelete: SetNull)

  @@index([teacherId])
  @@index([live])
}

model Presentation {
  id          String   @id
  title       String
  description String   @default("")
  theme       String   @default("light")
  layout      String   @default("flow")
  schema      Int      @default(2)
  /// the whole Presentation object; JSONB so blocks stay queryable
  data        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Null only for rows that predate accounts; those stay admin-visible.
  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  progress     Progress?
  quizBlocks   QuizLink[]
  shares       Share[]
  liveSessions LiveSession[]

  @@index([updatedAt])
  @@index([ownerId])
}

model Question {
  id          String   @id
  stem        String
  options     String[]
  answerIndex Int      @default(0)
  explanation String   @default("")
  /// ordered path segments, root first
  tags        String[] @default([])
  source      String   @default("")
  year        Int?
  /// 1 (very easy) … 5 (very hard)
  difficulty  Int      @default(3)
  starred     Boolean  @default(false)
  used        Int      @default(0)
  /// AnswerKey: { title?, steps: SlideStep[] } — a full teaching slide
  answerKey   Json?
  /// Figures for the stem and the options: { questionBlocks, optionBlocks }
  figure      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  quizBlocks QuizLink[]

  @@index([difficulty])
  @@index([ownerId])
  @@index([starred])
  @@index([source, year])
  @@index([tags], type: Gin)
}

/// A quiz block inside a deck that mirrors a question from the bank. The link
/// is what lets the presenter show that question's answer key.
model QuizLink {
  id           String @id
  stepId       String
  presentation String
  question     String

  deck      Presentation @relation(fields: [presentation], references: [id], onDelete: Cascade)
  question_ Question     @relation(fields: [question], references: [id], onDelete: Cascade)

  @@unique([stepId, presentation])
  @@index([presentation])
}

model Progress {
  /// presentation id
  presentationId String   @id
  /// global step index the teacher stopped at
  step           Int
  updatedAt      DateTime @updatedAt

  deck Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)
}
