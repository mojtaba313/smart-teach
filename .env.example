DATABASE_URL="postgresql://smart:smart@localhost:5432/smart_teach?schema=public"

# Image storage, in a GitHub repository via the Contents API.
# The token is read by the server only and is never sent to the browser.
# It should be a fine-grained PAT with Contents: read+write on that one repo.
GITHUB_TOKEN="github_pat_..."
GITHUB_OWNER="your-username"
GITHUB_REPO="smart-teach-media"
GITHUB_BRANCH="main"
